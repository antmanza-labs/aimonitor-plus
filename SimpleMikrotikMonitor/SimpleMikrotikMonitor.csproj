<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Antmanza Labs</Company>
    <Authors>Antmanza Labs</Authors>
    <Product>AIMonitor+</Product>
    <Description>AI log triage for MikroTik routers</Description>
    <Copyright>© 2025-2026 Antmanza Labs. MIT License.</Copyright>
    <PackageProjectUrl>https://www.antmanza.co.za</PackageProjectUrl>
    <Version>2.0.0</Version>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\logo.ico">
      <Link>logo.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.6.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="tik4net" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Settings now live in %APPDATA%\AIMonitorPlus (encrypted); never ship a settings file next to the exe. -->
    <None Remove="appsettings.json" />
    <EmbeddedResource Include="Prompts\mikrotik-triage.md" />
    <EmbeddedResource Include="..\TERMS.md" LogicalName="SimpleMikrotikMonitor.TERMS.md" />
    <InternalsVisibleTo Include="AIMonitor.Tests" />
  </ItemGroup>

</Project>
